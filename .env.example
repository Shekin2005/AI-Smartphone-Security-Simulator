NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/smartphone_security
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Exact public origin for the same-origin API guard.
# Required in production behind a proxy, e.g. https://your-app.onrender.com
PUBLIC_ORIGIN=

# Where the Strix scanner lives. Defaults to http://127.0.0.1:8000.
# Point this at the scanner's tunnel/VM URL when it runs elsewhere.
STRIX_SCANNER_URL=

# Shared secret between this app and the scanner. MUST be identical on
# both sides. Required whenever the scanner is reachable from outside
# localhost, otherwise anyone could run scans on your model credits.
STRIX_SCAN_TOKEN=
