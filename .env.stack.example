# ==================================================
# FULL STACK ENVIRONMENT
# ==================================================
# Copy to .env.stack and fill in:
#   cp .env.stack.example .env.stack
#   chmod 600 .env.stack
#
# This file is gitignored. It replaces Render's Environment tab.
# ==================================================

# ---- database ----
# Neon works unchanged. If the database lives on the same host, use
# host.docker.internal instead of localhost, because inside a container
# "localhost" means the container itself.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/smartphone_security

# ---- secrets ----
# Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# MUST equal the value already used to encrypt existing TOTP secrets,
# or every existing account fails to log in.
# Generate a NEW one only for a fresh database: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# ---- public addressing ----
# The browser URL. Every POST /api/* is rejected unless Origin matches.
PUBLIC_ORIGIN=https://lab.example.com

# The hostname Caddy requests a certificate for. Usually the same
# hostname as PUBLIC_ORIGIN, without the scheme.
SITE_ADDRESS=lab.example.com

# ---- scanner ----
# Shared secret between app and scanner. Generate: openssl rand -hex 24
STRIX_SCAN_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Optional defaults; the console can supply both per scan instead.
STRIX_LLM=
LLM_API_KEY=

# ---- lab flags ----
LAB_VULNERABLE_MODE=true
LAB_RECOVERY_DATABASE_URL=
